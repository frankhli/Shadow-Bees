# ==========================================
# Tiaohai Global - Environment Variables
# ==========================================

# Database (Docker本地开发)
DATABASE_URL="postgresql://tiaohai:tiaohai123@localhost:5432/tiaohai?schema=public"

# Next.js Web App
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NestJS API
PORT=3001
JWT_SECRET="dev-secret-key-change-in-production"
JWT_EXPIRATION="7d"

# AI Service (Fastify)
AI_SERVICE_PORT=3002
OPENAI_API_KEY="sk-demo-key-replace-with-real-key"
OPENAI_MODEL="gpt-4o"

# Stripe (测试模式)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_demo"
STRIPE_SECRET_KEY="sk_test_demo"
STRIPE_WEBHOOK_SECRET="whsec_demo"
STRIPE_PLATFORM_FEE_PERCENT=15

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="demo-key"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN="pk.demo_token"

# AWS S3 (可选)
AWS_ACCESS_KEY_ID="demo"
AWS_SECRET_ACCESS_KEY="demo"
AWS_S3_BUCKET="tiaohai-uploads-demo"
AWS_REGION="ap-southeast-1"

# Cloudbeds (可选)
CLOUDBEDS_CLIENT_ID="demo"
CLOUDBEDS_CLIENT_SECRET="demo"

# WhatsApp (可选)
WHATSAPP_API_TOKEN="demo"
WHATSAPP_PHONE_NUMBER_ID="demo"

# 加密
ENCRYPTION_KEY="demo-32-character-encryption-key"
