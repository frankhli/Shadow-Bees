# ==========================================
# Tiaohai Global - Environment Variables
# ==========================================

# 🚀 快速启动提示
# 首次启动只需 Docker Desktop，无需配置任何 API Key
# 运行 ./launch.sh 或 ./quick-start.sh 即可
# AI 服务会自动进入 Mock 模式（无需 OpenAI Key）

# ==========================================
# 基础配置（已预设，通常无需修改）
# ==========================================

# Database (Docker本地开发)
DATABASE_URL="postgresql://tiaohai:tiaohai123@localhost:5432/tiaohai?schema=public"

# Next.js Web App
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NestJS API
PORT=3001
JWT_SECRET="dev-secret-key-change-in-production"
JWT_EXPIRATION="7d"

# AI Service (Fastify)
AI_SERVICE_PORT=3002

# Redis (Docker本地开发)
REDIS_URL="redis://localhost:6379"

# Meilisearch (Docker本地开发)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="demo-key"

# ==========================================
# 可选配置（按需填写）
# ==========================================

# 🤖 OpenAI - 如需真实 AI 功能，取消注释并填入你的 Key
# OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_MODEL="gpt-4o"

# 🔍 Pinecone - 如需向量搜索，取消注释并填入
# PINECONE_API_KEY="your-pinecone-api-key"
# PINECONE_INDEX="tiaohai-knowledge"

# 💳 Stripe - 如需真实支付，取消注释并填入
# STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_key"
# STRIPE_SECRET_KEY="sk_test_your_stripe_secret"
# STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
# STRIPE_PLATFORM_FEE_PERCENT=15

# 🗺️ Mapbox - 如需地图功能，取消注释并填入
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token"

# 📱 WhatsApp Business API
# WHATSAPP_API_TOKEN="your-whatsapp-api-token"
# WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# 🏨 Cloudbeds (PMS Integration)
# CLOUDBEDS_API_KEY="your-cloudbeds-api-key"
# CLOUDBEDS_WEBHOOK_SECRET="your-webhook-secret"

# ✉️ Email (SendGrid)
# SENDGRID_API_KEY="your-sendgrid-api-key"
# FROM_EMAIL="noreply@tiaohai.com"

# 📁 File Storage (AWS S3)
# AWS_ACCESS_KEY_ID="your-aws-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# AWS_S3_BUCKET="tiaohai-uploads"
# AWS_REGION="ap-southeast-1"

# 🔐 Encryption (for passport numbers)
ENCRYPTION_KEY="demo-32-character-encryption-key"

# ==========================================
# 开发提示
# ==========================================
# 1. 首次启动只需运行 ./launch.sh
# 2. 日常使用运行 ./quick-start.sh
# 3. AI 默认 Mock 模式，无需 OpenAI Key 即可开发
# 4. 如需真实 AI，设置 OPENAI_API_KEY 后重启 AI 服务
